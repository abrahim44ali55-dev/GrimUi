        function TabContent:_bind(frame) frame:SetAttribute("Tab", Name); if Name ~= "Combat" then frame.Visible = false end; table.insert(TabContent.Elements, frame) end
        -- override addElement to auto bind
        local oldMethods = {}
        for k,v in pairs(TabContent) do if type(v)=="function" then oldMethods[k]=v end end
        -- We already handle visibility via attribute

        if Name == "Combat" then Btn:Activate() end
        return TabContent
