function ThemeEngine:GetLuminance(c)
	if typeof(c) ~= "Color3" then return 0 end
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

function ThemeEngine:ContrastText(bg)
	return self:GetLuminance(bg) > 0.58 and Color3.fromRGB(15, 23, 42) or Color3.fromRGB(248, 250, 252)
end

function ThemeEngine:GetToken(token)
	local theme = self.Presets[self.Current] or self.Presets.ObsidianDark
	if theme[token] ~= nil then return theme[token] end
	return self.Presets.ObsidianDark[token]
end

function ThemeEngine:Bind(inst, propMap)
	if not inst or type(propMap) ~= "table" then return inst end
	self.BoundObjects[inst] = propMap
	for prop, token in pairs(propMap) do
		local val = self:GetToken(token)
		if val ~= nil then
			pcall(function() inst[prop] = val end)
		end
	end
	return inst
end

function ThemeEngine:RegisterCustomTheme(name, tbl)
	name = tostring(name or "CustomTheme")
	local base = self.Presets.ObsidianDark
	local merged = {}
	for k, v in pairs(base) do
		if tbl and tbl[k] ~= nil and typeof(tbl[k]) == typeof(v) then
			merged[k] = tbl[k]
		else
			merged[k] = v
		end
	end
	merged.Name = name
	merged.AccentText = self:ContrastText(merged.Accent)
	self.Presets[name] = merged
	return merged
end

function ThemeEngine:SetTheme(themeNameOrTable, animate)
	animate = animate ~= false
	local target = self.Current
	if type(themeNameOrTable) == "string" then
		if self.Presets[themeNameOrTable] then
			target = themeNameOrTable
		else
			local map = {
				Dark = "ObsidianDark", Default = "ObsidianDark", Monochrome = "ObsidianDark",
				Light = "AlabasterLight", Serenity = "AlabasterLight",
				Green = "EmeraldMatrix", Plant = "EmeraldMatrix", Emerald = "EmeraldMatrix",
				Red = "CrimsonForge", Crimson = "CrimsonForge", Rose = "CrimsonForge",
				Amethyst = "AmethystRoyal", Violet = "AmethystRoyal",
				Ocean = "MidnightOcean", Aqua = "MidnightOcean", DarkBlue = "MidnightOcean",
				Amber = "SunsetAmber", AmberGlow = "SunsetAmber",
			}
			target = map[themeNameOrTable] or "ObsidianDark"
		end
	elseif type(themeNameOrTable) == "table" then
		local cName = themeNameOrTable.Name or "CustomTheme"
		self:RegisterCustomTheme(cName, themeNameOrTable)
		target = cName
	end

	self.Current = target
	local dur = self:GetToken("AnimSpeed") or 0.18

	for inst, propMap in pairs(self.BoundObjects) do
		if inst and inst.Parent then
			local tweenTarget = {}
			for prop, token in pairs(propMap) do
				local val = self:GetToken(token)
				if val ~= nil then
					if animate and (typeof(val) == "Color3" or typeof(val) == "number") then
						tweenTarget[prop] = val
					else
						pcall(function() inst[prop] = val end)
					end
				end
			end
			if next(tweenTarget) then
				AnimationManager:Tween(inst, tweenTarget, dur)
			end
		else
			self.BoundObjects[inst] = nil
		end
	end

	for _, fn in ipairs(self.Listeners) do
		task.spawn(pcall, fn, self.Presets[target])
	end
	return self.Presets[target]
end

