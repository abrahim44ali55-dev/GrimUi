		winH = cfg.Size.Y.Offset > 0 and cfg.Size.Y.Offset or winH
	elseif type(cfg.Width) == "number" and type(cfg.Height) == "number" then
		winW, winH = cfg.Width, cfg.Height
	end

	local rootFrame = Factory.Create("Frame", {
		Name = "MainWindow",
		Size = UDim2.fromOffset(winW, winH),
		Position = UDim2.fromOffset(math.floor((vp.X - winW) / 2), math.floor((vp.Y - winH) / 2)),
		ClipsDescendants = true,
		ThemeTag = { BackgroundColor3 = "WindowBg", BackgroundTransparency = "WindowTransparency" },
		Parent = screenGui,
	}, {
		Factory.Corner(nil, "CornerWindow"),
		Factory.Stroke(nil, "Border", 1, 0.25),
	})

	local topBar = Factory.Create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 46),
		ThemeTag = { BackgroundColor3 = "HeaderBg" },
		Parent = rootFrame,
	}, { Factory.Corner(nil, "CornerWindow") })

	Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, -1),
		ThemeTag = { BackgroundColor3 = "Divider" },
		Parent = topBar,
	})

	Factory.Create("TextLabel", {
		Size = UDim2.new(0.45, -20, 0, 18),
		Position = UDim2.fromOffset(16, 7),
		BackgroundTransparency = 1,
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ThemeTag = { TextColor3 = "TextPrimary" },
		Parent = topBar,
	})

	Factory.Create("TextLabel", {
		Size = UDim2.new(0.45, -20, 0, 14),
		Position = UDim2.fromOffset(16, 25),
		BackgroundTransparency = 1,
		Text = subTitle,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ThemeTag = { TextColor3 = "TextMuted" },
		Parent = topBar,
	})

	local searchBox = Factory.Create("TextBox", {
		Size = UDim2.fromOffset(175, 28),
		Position = UDim2.new(1, -82, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = "",
		PlaceholderText = "Search all tabs...",
		Font = Enum.Font.Gotham,
		TextSize = 11,
		ClearTextOnFocus = false,
		ThemeTag = { BackgroundColor3 = "InputBg", TextColor3 = "TextPrimary", PlaceholderColor3 = "TextMuted" },
		Parent = topBar,
	}, {
		Factory.Corner(nil, "CornerSmall"),
		Factory.Stroke(nil, "Border", 1, 0.35),
		Factory.Padding(nil, 0, 0, 10, 10),
	})

	local minBtn = Factory.Create("TextButton", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -44, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = "—",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		ThemeTag = { BackgroundColor3 = "ElementBg", TextColor3 = "TextPrimary" },
		Parent = topBar,
	}, { Factory.Corner(nil, "CornerSmall") })

	local closeBtn = Factory.Create("TextButton", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = "×",
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		ThemeTag = { BackgroundColor3 = "ElementBg", TextColor3 = "Error" },
		Parent = topBar,
	}, { Factory.Corner(nil, "CornerSmall") })

	local sideW = tonumber(cfg.TabWidth or cfg.SideBarWidth) or 165
	local sidebar = Factory.Create("ScrollingFrame", {
		Size = UDim2.new(0, sideW, 1, -46),
		Position = UDim2.fromOffset(0, 46),
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ThemeTag = { BackgroundColor3 = "SidebarBg", ScrollBarImageColor3 = "Accent" },
		Parent = rootFrame,
	}, {
		Factory.Padding(nil, 10, 10, 10, 10),
		Factory.Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local contentArea = Factory.Create("Frame", {
		Size = UDim2.new(1, -sideW, 1, -46),
		Position = UDim2.fromOffset(sideW, 46),
		BackgroundTransparency = 1,
		Parent = rootFrame,
	})

	local emptySearchLbl = Factory.Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "No matching elements found.",
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		Visible = false,
		ThemeTag = { TextColor3 = "TextMuted" },
		Parent = contentArea,
	})

	local win = {
		Title = title,
		ScreenGui = screenGui,
		RootFrame = rootFrame,
		Sidebar = sidebar,
		ContentArea = contentArea,
		Tabs = {},
		ActiveTab = nil,
		Minimized = false,
		Hidden = false,
		SavedSize = UDim2.fromOffset(winW, winH),
		Maid = maid,
	}

	local dragging, dragStart, startPos = false, nil, nil
	maid:Connect(topBar.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = inp.Position; startPos = rootFrame.Position
		end
	end)
	maid:Connect(UserInputService.InputChanged, function(inp)
		if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			local d = inp.Position - dragStart
			local curVp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
			local nx = math.clamp(startPos.X.Offset + d.X, 4, math.max(4, curVp.X - rootFrame.AbsoluteSize.X - 4))
			local ny = math.clamp(startPos.Y.Offset + d.Y, 4, math.max(4, curVp.Y - rootFrame.AbsoluteSize.Y - 4))
			rootFrame.Position = UDim2.fromOffset(nx, ny)
		end
	end)
	maid:Connect(UserInputService.InputEnded, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	function win:Minimize()
		self.Minimized = not self.Minimized
		if self.Minimized then
			self.SavedSize = rootFrame.Size
			sidebar.Visible = false
			contentArea.Visible = false
			AnimationManager:Tween(rootFrame, { Size = UDim2.fromOffset(self.SavedSize.X.Offset, 46) }, 0.2)
		else
			sidebar.Visible = true
			contentArea.Visible = true
			AnimationManager:Tween(rootFrame, { Size = self.SavedSize }, 0.2)
		end
		return self
	end

	function win:SetVisible(v)
		self.Hidden = not (v == true)
		rootFrame.Visible = not self.Hidden
		return self
	end
	function win:Toggle() return self:SetVisible(self.Hidden) end

	maid:Connect(minBtn.MouseButton1Click, function() win:Minimize() end)
	maid:Connect(closeBtn.MouseButton1Click, function()
		ModalManager:Show(rootFrame, {
			Title = "Unload Interface",
			Content = "Are you sure you want to close " .. win.Title .. "?",
			YesText = "Close",
			NoText = "Cancel",
			OnYes = function() win:Destroy() end,
		})
	end)

	local toggleKey = cfg.MinimizeKey or cfg.ToggleKey or cfg.ToggleUIKeybind or Enum.KeyCode.RightControl
	maid:Connect(UserInputService.InputBegan, function(inp, gp)
		if gp or UserInputService:GetFocusedTextBox() then return end
		if typeof(toggleKey) == "EnumItem" and inp.KeyCode == toggleKey then
			win:Toggle()
		elseif type(toggleKey) == "string" and inp.KeyCode.Name:lower() == toggleKey:lower() then
			win:Toggle()
		end
	end)

	function win:Search(query)
		query = tostring(query or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
		if query == "" then
			emptySearchLbl.Visible = false
			for _, t in ipairs(self.Tabs) do
				t.Button.Visible = true
				t.Container.Visible = (t == self.ActiveTab)
				for _, el in ipairs(t.Elements) do
					if el.Root then el.Root.Visible = el.Visible ~= false end
				end
			end
			return
		end

		local total = 0
		local firstTab = nil
		for _, t in ipairs(self.Tabs) do
			local matches = 0
			local tabMatch = t.Title:lower():find(query, 1, true) ~= nil
			for _, el in ipairs(t.Elements) do
				local m = tabMatch
					or (el.Title and el.Title:lower():find(query, 1, true) ~= nil)
					or (el.Description and tostring(el.Description):lower():find(query, 1, true) ~= nil)
				if el.Root then el.Root.Visible = m and (el.Visible ~= false) end
				if m then matches += 1; total += 1 end
			end
			t.Button.Visible = (matches > 0 or tabMatch)
			if matches > 0 and not firstTab then firstTab = t end
		end
		if firstTab and (not self.ActiveTab or not self.ActiveTab.Button.Visible) then
			self:SelectTab(firstTab)
		end
		emptySearchLbl.Visible = (total == 0)
	end

	maid:Connect(searchBox:GetPropertyChangedSignal("Text"), function()
		win:Search(searchBox.Text)
	end)

	function win:SelectTab(tabOrIdx)
		local target = type(tabOrIdx) == "number" and self.Tabs[tabOrIdx] or tabOrIdx
		if type(tabOrIdx) == "string" then
			for _, t in ipairs(self.Tabs) do
				if t.Title == tabOrIdx then target = t break end
			end
		end
		if not target then return end
		self.ActiveTab = target
		for _, t in ipairs(self.Tabs) do
			local sel = (t == target)
			t.Selected = sel
			t.Container.Visible = sel
			ThemeEngine:Bind(t.Button, {
				BackgroundColor3 = sel and "Accent" or "ElementBg",
				TextColor3 = sel and "AccentText" or "TextSecondary",
			})
			AnimationManager:Tween(t.Button, {
				BackgroundColor3 = ThemeEngine:GetToken(sel and "Accent" or "ElementBg"),
				TextColor3 = ThemeEngine:GetToken(sel and "AccentText" or "TextSecondary"),
			}, 0.15)
		end
	end

	function win:CreateTab(tCfgOrName, iconArg)
		local tCfg = type(tCfgOrName) == "table" and tCfgOrName or { Title = tostring(tCfgOrName), Icon = iconArg }
		local tTitle = tostring(tCfg.Title or tCfg.Name or ("Tab " .. tostring(#self.Tabs + 1)))
		local tIcon = tCfg.Icon or tCfg.Image
		local tMaid = Lifecycle.new()
		self.Maid:Add(tMaid)

		local btn = Factory.Create("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			Text = tTitle,
			Font = Enum.Font.GothamSemibold,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = #self.Tabs + 1,
			ThemeTag = { BackgroundColor3 = "ElementBg", TextColor3 = "TextSecondary" },
			Parent = sidebar,
		}, {
			Factory.Corner(nil, "CornerSmall"),
			Factory.Padding(nil, 0, 0, tIcon and 30 or 10, 8),
		})
		tMaid:Add(btn)

		if tIcon then
			local ic = Factory.Create("ImageLabel", {
				Size = UDim2.fromOffset(15, 15),
				Position = UDim2.new(0, -19, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = btn,
			})
			IconManager:Apply(ic, tIcon, "TextSecondary")
		end

		local page = Factory.Create("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			ScrollBarThickness = 3,
			CanvasSize = UDim2.fromScale(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ThemeTag = { ScrollBarImageColor3 = "Accent" },
			Parent = contentArea,
		}, {
			Factory.Padding(nil, 12, 16, 12, 12),
			Factory.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		tMaid:Add(page)

		local tabObj = {
			Title = tTitle,
			Name = tTitle,
			Window = self,
			Button = btn,
			Container = page,
			Elements = {},
			IsScrolling = false,
			Maid = tMaid,
		}

		tMaid:Connect(page:GetPropertyChangedSignal("CanvasPosition"), function()
			tabObj.IsScrolling = true
			task.delay(0.22, function() tabObj.IsScrolling = false end)
		end)

		function tabObj:RegisterElement(el)
			table.insert(self.Elements, el)
			return el
		end

		function tabObj:AddSection(sCfgOrTitle)
			local sCfg = type(sCfgOrTitle) == "table" and sCfgOrTitle or { Title = tostring(sCfgOrTitle or "Section") }
			local sTitle = tostring(sCfg.Title or sCfg.Name or "Section")
			local opened = sCfg.Opened ~= false

			local secFrame = Factory.Create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				ThemeTag = { BackgroundColor3 = "SectionBg" },
				Parent = page,
			}, {
				Factory.Corner(nil, "CornerElement"),
				Factory.Stroke(nil, "Divider", 1, 0.5),
				Factory.Padding(nil, 10, 10, 10, 10),
				Factory.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			})

			local hdr = Factory.Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = sTitle:upper(),
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 1,
				ThemeTag = { TextColor3 = "Accent" },
				Parent = secFrame,
			})

			local body = Factory.Create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = opened,
				LayoutOrder = 2,
				Parent = secFrame,
			}, {
				Factory.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			})

			tMaid:Connect(hdr.MouseButton1Click, function()
				opened = not opened
				body.Visible = opened
			end)

			local secObj = {
				Title = sTitle,
				Root = secFrame,
				Container = body,
				Set = function(s, t) hdr.Text = tostring(t):upper() return s end,
			}
			bindElementGenerators(secObj, tabObj, body)
			return secObj
		end
		tabObj.CreateSection = tabObj.AddSection
		tabObj.Section = tabObj.AddSection

		bindElementGenerators(tabObj, tabObj, page)

		tMaid:Connect(btn.MouseButton1Click, function()
			self:SelectTab(tabObj)
		end)

		table.insert(self.Tabs, tabObj)
		if #self.Tabs == 1 then self:SelectTab(tabObj) end
		return tabObj
	end

	win.AddTab = win.CreateTab
	win.MakeTab = win.CreateTab
	win.Tab = win.CreateTab
	win.Dialog = function(self, c) return ModalManager:Show(rootFrame, c) end
	win.Confirm = win.Dialog
	win.Notify = function(self, c) return NotificationManager:Notify(c) end
	win.SetTheme = function(self, t) return ThemeEngine:SetTheme(t, true) end
	win.ModifyTheme = win.SetTheme

	function win:Destroy()
		if maid:IsDestroyed() then return false end
		local idx = table.find(WindowManager.Windows, self)
		if idx then table.remove(WindowManager.Windows, idx) end
		return maid:Destroy()
	end

	table.insert(self.Windows, win)
	return win
end

