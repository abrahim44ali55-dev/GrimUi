-- ============================================================================
-- MODULE 1: LIFECYCLE & CLEANUP MANAGER (IDEMPOTENT HIERARCHICAL MAID)
-- ============================================================================
local Lifecycle = {}
Lifecycle.__index = Lifecycle

function Lifecycle.new()
	return setmetatable({
		_tasks = {},
		_destroyed = false,
	}, Lifecycle)
end

function Lifecycle:Add(taskObj)
	if self._destroyed then
		Lifecycle._cleanupTask(taskObj)
		return taskObj
	end
	table.insert(self._tasks, taskObj)
	return taskObj
end

function Lifecycle:Connect(signal, callback)
	if self._destroyed or not signal then return nil end
	local conn = signal:Connect(callback)
	table.insert(self._tasks, conn)
	return conn
end

function Lifecycle._cleanupTask(t)
	local tType = typeof(t)
	if tType == "RBXScriptConnection" then
		if t.Connected then pcall(function() t:Disconnect() end) end
	elseif tType == "Instance" then
		pcall(function() t:Destroy() end)
	elseif tType == "function" then
		pcall(t)
	elseif tType == "thread" then
		pcall(task.cancel, t)
	elseif tType == "table" then
		if type(t.Destroy) == "function" then
			pcall(function() t:Destroy() end)
		elseif type(t.Disconnect) == "function" then
			pcall(function() t:Disconnect() end)
		elseif type(t.Cancel) == "function" then
			pcall(function() t:Cancel() end)
		end
	end
end

function Lifecycle:Clean()
	local tasks = self._tasks
	self._tasks = {}
	for i = #tasks, 1, -1 do
		Lifecycle._cleanupTask(tasks[i])
		tasks[i] = nil
	end
end

function Lifecycle:Destroy()
	if self._destroyed then
		return false -- Safe idempotent no-op on repeated calls
	end
	self._destroyed = true
	self:Clean()
	return true
end

function Lifecycle:IsDestroyed()
	return self._destroyed
end

function Lifecycle:GetActiveTaskCount()
	return #self._tasks
end

