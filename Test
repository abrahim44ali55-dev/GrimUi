local UltraFusion = {
	Version = "2.0.0",
	Lifecycle = Lifecycle,
	Diagnostics = Diagnostics,
	AnimationManager = AnimationManager,
	ThemeEngine = ThemeEngine,
	IconManager = IconManager,
	StateManager = StateManager,
	NotificationManager = NotificationManager,
	ModalManager = ModalManager,
	ComponentRegistry = ComponentRegistry,
	WindowManager = WindowManager,

	Flags = StateManager.Flags,
	Options = StateManager.Options,
	Themes = ThemeEngine.Presets,
	Icons = IconManager.Assets,
}

function UltraFusion:CreateWindow(cfg)
	local w = WindowManager:CreateWindow(cfg)
	self.Window = w
	return w
end
UltraFusion.MakeWindow = UltraFusion.CreateWindow

function UltraFusion:Notify(cfg)
	if not NotificationManager.Holder then
		local g = Factory.Create("ScreenGui", {
			Name = "UltraFusion_Notifications",
			ResetOnSpawn = false,
			DisplayOrder = 200,
			Parent = Factory.GetSafeParent(),
		})
		NotificationManager:Init(g)
	end
	return NotificationManager:Notify(cfg)
end
UltraFusion.MakeNotification = UltraFusion.Notify

function UltraFusion:SetTheme(t) return ThemeEngine:SetTheme(t, true) end
function UltraFusion:RegisterTheme(n, t) return ThemeEngine:RegisterCustomTheme(n, t) end
function UltraFusion:GetIcon(n) local r = IconManager:Resolve(n) return r and r.Image or nil end
function UltraFusion:SaveConfiguration(p) return StateManager:SaveConfiguration(p) end
function UltraFusion:LoadConfiguration(p) return StateManager:LoadConfiguration(p) end
function UltraFusion:ExportJSON() return StateManager:ExportJSON(true) end
function UltraFusion:ImportJSON(s) return StateManager:ImportJSON(s) end
function UltraFusion:Init()
	if StateManager.AutoSave then StateManager:LoadConfiguration("Default") end
	return self
end
function UltraFusion:Destroy()
	for i = #WindowManager.Windows, 1, -1 do
		local w = WindowManager.Windows[i]
		if w then w:Destroy() end
	end
	self.Window = nil
	return true
end

if getgenv then
	getgenv().UltraFusion = UltraFusion
end

return UltraFusion
