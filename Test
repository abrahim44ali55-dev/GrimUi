	maid:Connect(card.MouseEnter, function() paused = true end)
	maid:Connect(card.MouseLeave, function() paused = false end)
	maid:Connect(closeBtn.MouseButton1Click, function() toast:Close() end)

	function toast:Close()
		if self.Closed then return end
		self.Closed = true
		local idx = table.find(NotificationManager.Active, self)
		if idx then table.remove(NotificationManager.Active, idx) end
		AnimationManager:Tween(card, { Position = UDim2.new(1, 350, 0, 0) }, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In, function()
			maid:Destroy()
		end)
	end
	toast.Destroy = toast.Close

	table.insert(self.Active, toast)
	AnimationManager:Tween(card, { Position = UDim2.fromOffset(0, 0) }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	if dur > 0 then
		maid:Connect(RunService.Heartbeat, function(dt)
			if not paused and not toast.Closed then
				elapsed += dt
				bar.Size = UDim2.new(math.clamp(1 - (elapsed / dur), 0, 1), 0, 0, 2)
				if elapsed >= dur then toast:Close() end
			end
		end)
	end
	return toast
end

