local WindowManager = { Windows = {} }

local function bindElementGenerators(target, tab, containerOverride)
	local function add(typeName, cfg, extra1, extra2)
		if type(cfg) ~= "table" then
			if typeName == "paragraph" and extra1 ~= nil then
				cfg = { Title = tostring(cfg), Description = tostring(extra1) }
			else
				cfg = { Title = tostring(cfg) }
			end
		else
			cfg = table.clone(cfg)
		end
		if containerOverride then cfg.ParentContainer = containerOverride end
		local fn = ComponentRegistry.Builders[typeName:lower()]
		if not fn then return nil end
		return fn(tab, cfg)
	end

	function target:AddButton(c) return add("button", c) end
	function target:AddIconButton(c) return add("iconbutton", c) end
	function target:AddToggle(idOrC, c)
		if type(idOrC) == "string" and type(c) == "table" then c.Flag = idOrC return add("toggle", c) end
		return add("toggle", idOrC)
	end
	function target:AddSlider(idOrC, c)
		if type(idOrC) == "string" and type(c) == "table" then c.Flag = idOrC return add("slider", c) end
		return add("slider", idOrC)
	end
	function target:AddSliderInput(c) return add("sliderinput", c) end
	function target:AddInput(idOrC, c)
		if type(idOrC) == "string" and type(c) == "table" then c.Flag = idOrC return add("input", c) end
		return add("input", idOrC)
	end
	function target:AddTextbox(c) return add("textbox", c) end
	function target:AddDropdown(idOrC, c)
		if type(idOrC) == "string" and type(c) == "table" then c.Flag = idOrC return add("dropdown", c) end
		return add("dropdown", idOrC)
	end
	function target:AddColorPicker(idOrC, c)
		if type(idOrC) == "string" and type(c) == "table" then c.Flag = idOrC return add("colorpicker", c) end
		return add("colorpicker", idOrC)
	end
	target.AddColorpicker = target.AddColorPicker
	function target:AddKeybind(idOrC, c)
		if type(idOrC) == "string" and type(c) == "table" then c.Flag = idOrC return add("keybind", c) end
		return add("keybind", idOrC)
	end
	target.AddBind = target.AddKeybind
	function target:AddLabel(t, i, col) return add("label", t, i, col) end
	function target:AddParagraph(t, d) return add("paragraph", t, d) end
	function target:AddDivider(c) return add("divider", c) end
	target.AddSeparator = target.AddDivider
	function target:AddProgressBar(c) return add("progressbar", c) end
	function target:AddCode(c) return add("code", c) end
	function target:AddLinkButton(c) return add("linkbutton", c) end
	function target:AddBadge(c) return add("badge", c) end
	function target:AddPlayerStats(c) return add("playerstats", c) end
	function target:AddFloatingButton(c) return add("floatingbutton", c) end

	-- Rayfield / WindUI / GGH Aliases
	target.CreateButton = target.AddButton
	target.CreateToggle = target.AddToggle
	target.CreateSlider = target.AddSlider
	target.CreateInput = target.AddInput
	target.CreateDropdown = target.AddDropdown
	target.CreateColorPicker = target.AddColorPicker
	target.CreateKeybind = target.AddKeybind
	target.CreateLabel = target.AddLabel
	target.CreateParagraph = target.AddParagraph
	target.CreateDivider = target.AddDivider

	target.Button = target.AddButton
	target.Toggle = target.AddToggle
	target.Slider = target.AddSlider
	target.SliderInput = target.AddSliderInput
	target.Input = target.AddInput
	target.Dropdown = target.AddDropdown
	target.Colorpicker = target.AddColorPicker
	target.Keybind = target.AddKeybind
	target.Label = target.AddLabel
	target.Paragraph = target.AddParagraph
	target.Divider = target.AddDivider
	target.Separator = target.AddDivider
	target.ProgressBar = target.AddProgressBar
	target.Code = target.AddCode
	target.LinkButton = target.AddLinkButton
	target.PlayerStats = target.AddPlayerStats
	target.FloatButton = target.AddFloatingButton

	function target:Add(typeName, c)
		return add(tostring(typeName), c)
	end
