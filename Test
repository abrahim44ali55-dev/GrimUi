-- MODULE 2: ERROR HANDLING & DIAGNOSTICS ENGINE
-- ============================================================================
local Diagnostics = {
	DebugMode = false,
	Logs = {},
	Listeners = {},
}

function Diagnostics:SetDebugMode(enabled)
	self.DebugMode = enabled == true
end

function Diagnostics:Log(level, scope, message)
	local entry = {
		Time = os.clock(),
		Level = tostring(level),
		Scope = tostring(scope),
		Message = tostring(message),
	}
	table.insert(self.Logs, entry)
	if #self.Logs > 250 then
		table.remove(self.Logs, 1)
	end
	if self.DebugMode or level == "ERROR" or level == "WARN" then
		warn(string.format("[UltraFusion.%s] [%s]: %s", entry.Level, entry.Scope, entry.Message))
	end
	for _, fn in ipairs(self.Listeners) do
		task.spawn(pcall, fn, entry)
	end
	return entry
end

function Diagnostics:SafeCallback(scope, callback, onErrorVisual, ...)
	if type(callback) ~= "function" then
		return true, nil
	end
	local args = table.pack(...)
	local ok, res = xpcall(function()
		return callback(table.unpack(args, 1, args.n))
	end, function(err)
		return debug.traceback(tostring(err), 2)
	end)

	if not ok then
		local shortErr = tostring(res):match(":%d+: ([^\n]+)") or tostring(res)
		self:Log("ERROR", scope or "Callback", shortErr)
		if type(onErrorVisual) == "function" then
			task.spawn(pcall, onErrorVisual, shortErr)
		end
		return false, shortErr
	end
	return true, res
end

