-- MODULE 7: STATE MANAGER & CONFIGURATION ENGINE
-- ============================================================================
local StateManager = {
	Flags = {},
	Options = {},
	KeyCounts = {},
	Version = 2,
	AutoSave = false,
	Adapter = {
		_mem = {},
		Write = function(self, profile, content)
			self._mem[profile] = content
			if type(writefile) == "function" then
				pcall(function()
					if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("UltraFusion_Configs") then
						makefolder("UltraFusion_Configs")
					end
					writefile("UltraFusion_Configs/" .. tostring(profile) .. ".json", content)
				end)
			end
			return true
		end,
		Read = function(self, profile)
			if self._mem[profile] then return self._mem[profile] end
			if type(isfile) == "function" and type(readfile) == "function" then
				local p = "UltraFusion_Configs/" .. tostring(profile) .. ".json"
				local ok, data = pcall(function()
					if isfile(p) then return readfile(p) end
					return nil
				end)
				if ok and data then return data end
			end
			return nil
		end,
		Exists = function(self, profile)
			if self._mem[profile] ~= nil then return true end
			if type(isfile) == "function" then
				local ok, ex = pcall(isfile, "UltraFusion_Configs/" .. tostring(profile) .. ".json")
				if ok and ex then return true end
			end
			return false
		end,
	},
}

function StateManager:GenerateStableId(tabName, elType, title, explicitFlag)
	if type(explicitFlag) == "string" and explicitFlag ~= "" then
		if self.Flags[explicitFlag] then
			local c = (self.KeyCounts[explicitFlag] or 1) + 1
			self.KeyCounts[explicitFlag] = c
			return explicitFlag .. "_" .. tostring(c)
		end
		self.KeyCounts[explicitFlag] = 1
		return explicitFlag
	end
	local base = string.format("%s::%s::%s", tostring(tabName or "Tab"), tostring(elType or "El"), tostring(title or "Item"))
	local c = (self.KeyCounts[base] or 0) + 1
	self.KeyCounts[base] = c
	return c == 1 and base or (base .. "#" .. tostring(c))
end

function StateManager:Register(id, ctrl)
	self.Flags[id] = ctrl
	self.Options[id] = ctrl
	return id
end

function StateManager:Unregister(id)
	if id then
		self.Flags[id] = nil
		self.Options[id] = nil
	end
end

function StateManager:ExportJSON(includeTheme)
	local data = {
		Version = self.Version,
		Theme = includeTheme ~= false and ThemeEngine.Current or nil,
		Elements = {},
	}
	for id, ctrl in pairs(self.Flags) do
		if ctrl and ctrl.Saveable ~= false and type(ctrl.GetValue) == "function" then
			local v = ctrl:GetValue()
			if ctrl.Type == "ColorPicker" and typeof(v) == "Color3" then
				data.Elements[id] = { __type = "Color3", Hex = v:ToHex(), Alpha = ctrl.Transparency or 0 }
			elseif typeof(v) == "EnumItem" then
				data.Elements[id] = { __type = "EnumItem", Name = v.Name }
			else
				data.Elements[id] = { __type = ctrl.Type, Value = v }
			end
		end
	end
	return HttpService:JSONEncode(data)
end

function StateManager:ImportJSON(jsonStr)
	if type(jsonStr) ~= "string" or jsonStr == "" then
		return false, "Empty JSON string"
	end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(jsonStr) end)
	if not ok or type(decoded) ~= "table" then
		Diagnostics:Log("WARN", "StateManager", "Invalid JSON configuration ignored")
		return false, "Malformed JSON"
	end

	if type(decoded.Theme) == "string" then
		ThemeEngine:SetTheme(decoded.Theme)
	end

	local elements = type(decoded.Elements) == "table" and decoded.Elements or decoded
	local restored = 0
	for id, entry in pairs(elements) do
		local ctrl = self.Flags[id]
		if ctrl and not ctrl:IsDestroyed() and type(ctrl.SetValue) == "function" then
			if ctrl.Type == "ColorPicker" and type(entry) == "table" and entry.Hex then
				local okC, col = pcall(Color3.fromHex, entry.Hex)
				if okC and col then
					ctrl:SetValue(col, entry.Alpha or 0, true)
					restored += 1
				end
			elseif type(entry) == "table" and entry.__type == "EnumItem" and entry.Name then
				ctrl:SetValue(entry.Name, nil, true)
				restored += 1
			elseif type(entry) == "table" and entry.Value ~= nil then
				ctrl:SetValue(entry.Value, true)
				restored += 1
			elseif type(entry) ~= "table" then
				ctrl:SetValue(entry, true)
				restored += 1
			end
		end
	end
	return true, restored
end

function StateManager:SaveConfiguration(profile)
	return self.Adapter:Write(tostring(profile or "Default"), self:ExportJSON(true))
end

function StateManager:LoadConfiguration(profile)
	local raw = self.Adapter:Read(tostring(profile or "Default"))
	if not raw then return false, "Profile not found" end
	return self:ImportJSON(raw)
end

