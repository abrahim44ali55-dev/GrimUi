-- MODULE 3: ANIMATION MANAGER (SPRING SOLVER + TWEEN DEDUPLICATION)
-- ============================================================================
local AnimationManager = {
	ActiveTweens = setmetatable({}, { __mode = "k" }),
	ActiveSprings = {},
	SpringConn = nil,
}

function AnimationManager:Tween(instance, props, duration, easingStyle, easingDirection, onComplete)
	if not instance or not instance.Parent then return nil end
	duration = duration or 0.2
	easingStyle = easingStyle or Enum.EasingStyle.Quint
	easingDirection = easingDirection or Enum.EasingDirection.Out

	local changed = false
	for k, v in pairs(props) do
		local ok, cur = pcall(function() return instance[k] end)
		if ok and cur ~= v then
			changed = true
			break
		end
	end
	if not changed then
		if onComplete then task.spawn(onComplete) end
		return nil
	end

	if self.ActiveTweens[instance] then
		pcall(function() self.ActiveTweens[instance]:Cancel() end)
	end

	local tw = TweenService:Create(instance, TweenInfo.new(duration, easingStyle, easingDirection), props)
	self.ActiveTweens[instance] = tw
	if onComplete then
		tw.Completed:Once(function(state)
			if self.ActiveTweens[instance] == tw then
				self.ActiveTweens[instance] = nil
			end
			if state == Enum.PlaybackState.Completed then
				pcall(onComplete)
			end
		end)
	end
	tw:Play()
	return tw
end

function AnimationManager:CreateSpring(initialValue, onStep, frequency, dampingRatio)
	local spring = {
		Value = initialValue or 0,
		Target = initialValue or 0,
		Velocity = 0,
		Frequency = frequency or 7,
		Damping = dampingRatio or 1,
		OnStep = onStep,
		Completed = true,
	}

	function spring:SetGoal(target, instant)
		self.Target = target
		if instant then
			self.Value = target
			self.Velocity = 0
			self.Completed = true
			if self.OnStep then pcall(self.OnStep, self.Value) end
			return
		end
		self.Completed = false
		if not table.find(AnimationManager.ActiveSprings, self) then
			table.insert(AnimationManager.ActiveSprings, self)
		end
		if not AnimationManager.SpringConn then
			AnimationManager.SpringConn = RunService.RenderStepped:Connect(function(dt)
				for i = #AnimationManager.ActiveSprings, 1, -1 do
					local s = AnimationManager.ActiveSprings[i]
					if s:Step(dt) then
						table.remove(AnimationManager.ActiveSprings, i)
					end
				end
				if #AnimationManager.ActiveSprings == 0 and AnimationManager.SpringConn then
					AnimationManager.SpringConn:Disconnect()
					AnimationManager.SpringConn = nil
				end
			end)
		end
	end

	function spring:Step(dt)
		if self.Completed then return true end
		dt = math.min(dt, 0.1)
		local f = self.Frequency * 2 * math.pi
		local offset = self.Value - self.Target
		local decay = math.exp(-f * dt)
		local nextVal = (offset * (1 + f * dt) + self.Velocity * dt) * decay + self.Target
		local nextVel = (self.Velocity * (1 - f * dt) - offset * (f * f * dt)) * decay

		if math.abs(nextVel) < 0.001 and math.abs(nextVal - self.Target) < 0.001 then
			self.Value = self.Target
			self.Velocity = 0
			self.Completed = true
		else
			self.Value = nextVal
			self.Velocity = nextVel
		end
		if self.OnStep then pcall(self.OnStep, self.Value) end
		return self.Completed
	end

	function spring:Destroy()
		self.Completed = true
		self.OnStep = nil
	end

	return spring
end

