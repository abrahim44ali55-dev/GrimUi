	AnimationManager:Tween(scale, { Scale = 1 }, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	return modal
end

-- ============================================================================
-- MODULE 9: COMPONENT REGISTRY & BASE ELEMENT CARD
-- ============================================================================
local ComponentRegistry = { Builders = {} }

function ComponentRegistry:Register(name, fn)
	self.Builders[name:lower()] = fn
end

function ComponentRegistry:CreateBaseCard(tab, cfg, hoverEnabled)
	local maid = Lifecycle.new()
	tab.Maid:Add(maid)

	local title = tostring(cfg.Title or cfg.Name or "Element")
	local desc = cfg.Description or cfg.Desc or cfg.Content or nil
	local hasDesc = type(desc) == "string" and desc ~= ""

	local root = Factory.Create("Frame", {
		Name = "Element_" .. title,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ThemeTag = { BackgroundColor3 = "ElementBg", BackgroundTransparency = "ElementTransparency" },
		Parent = cfg.ParentContainer or tab.Container,
	}, { Factory.Corner(nil, "CornerElement") })
	maid:Add(root)

	local stroke = Factory.Stroke(root, "Border", 1, 0.45)

	local content = Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = root,
	}, { Factory.Padding(nil, 10, 10, 12, 12) })

	local stack = Factory.Create("Frame", {
		Size = UDim2.new(1, -(tonumber(cfg.RightReservedWidth) or 0), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		Factory.Create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local titleLbl = Factory.Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = title,
		Font = Enum.Font.GothamSemibold,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
		ThemeTag = { TextColor3 = "TextPrimary" },
		Parent = stack,
	})

	local descLbl = Factory.Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 14),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = hasDesc and tostring(desc) or "",
		Visible = hasDesc,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
		ThemeTag = { TextColor3 = "TextSecondary" },
		Parent = stack,
	})

	local lockOverlay = Factory.Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 12, 18),
		BackgroundTransparency = 0.35,
		Text = "",
		Visible = false,
		ZIndex = 20,
		Parent = root,
	}, { Factory.Corner(nil, "CornerElement") })

	local lockText = Factory.Create("TextLabel", {
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = "Locked",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		ZIndex = 21,
		ThemeTag = { TextColor3 = "Warning" },
		Parent = lockOverlay,
	})

	local ctrl = {
		Type = cfg.Type or "Element",
		Title = title,
		Description = desc,
		Enabled = cfg.Enabled ~= false and not cfg.Locked,
		Visible = cfg.Visible ~= false,
		Locked = cfg.Locked == true,
		Saveable = cfg.Save ~= false,
		Root = root,
		Content = content,
		TextStack = stack,
		TitleLabel = titleLbl,
		DescLabel = descLbl,
		Stroke = stroke,
		Maid = maid,
		Listeners = {},
	}

	if hoverEnabled then
		maid:Connect(root.MouseEnter, function()
			if ctrl.Enabled and not ctrl.Locked then
				AnimationManager:Tween(root, { BackgroundColor3 = ThemeEngine:GetToken("ElementBgHover") }, 0.14)
			end
		end)
		maid:Connect(root.MouseLeave, function()
			if ctrl.Enabled and not ctrl.Locked then
				AnimationManager:Tween(root, { BackgroundColor3 = ThemeEngine:GetToken("ElementBg") }, 0.14)
			end
		end)
	end

	function ctrl:FlashError(err)
		titleLbl.Text = tostring(self.Title) .. " — Callback Error"
		AnimationManager:Tween(root, { BackgroundColor3 = ThemeEngine:GetToken("Error") }, 0.16)
		task.delay(0.85, function()
			if not maid:IsDestroyed() and root.Parent then
				titleLbl.Text = self.Title
				AnimationManager:Tween(root, { BackgroundColor3 = ThemeEngine:GetToken("ElementBg") }, 0.22)
			end
		end)
	end

	function ctrl:Highlight()
		if maid:IsDestroyed() or not stroke.Parent then return end
		AnimationManager:Tween(stroke, { Color = ThemeEngine:GetToken("Accent"), Thickness = 2, Transparency = 0 }, 0.16)
		task.delay(0.8, function()
			if not maid:IsDestroyed() and stroke.Parent then
				AnimationManager:Tween(stroke, { Color = ThemeEngine:GetToken("Border"), Thickness = 1, Transparency = 0.45 }, 0.25)
			end
		end)
	end

	function ctrl:SetTitle(t)
		self.Title = tostring(t or "")
		titleLbl.Text = self.Title
		return self
	end

	function ctrl:SetDescription(d)
		self.Description = d
		if d == nil or d == "" then
			descLbl.Visible = false
			descLbl.Text = ""
		else
			descLbl.Visible = true
			descLbl.Text = tostring(d)
		end
		return self
	end
	ctrl.SetDesc = ctrl.SetDescription

	function ctrl:SetVisible(v)
		self.Visible = v == true
		root.Visible = self.Visible
		return self
	end

	function ctrl:SetEnabled(en, reason)
		self.Enabled = en == true
		self.Locked = not self.Enabled
		lockOverlay.Visible = self.Locked
		lockText.Text = reason and ("Locked: " .. tostring(reason)) or "Disabled"
		return self
	end

	function ctrl:Lock(reason) return self:SetEnabled(false, reason or "Locked") end
	function ctrl:Unlock() return self:SetEnabled(true) end

	function ctrl:OnChanged(fn)
		if type(fn) == "function" then table.insert(self.Listeners, fn) end
		return self
	end

	function ctrl:_fireChanged(val, silent)
		if silent then return end
		for _, fn in ipairs(self.Listeners) do
			Diagnostics:SafeCallback(self.Title .. ":OnChanged", fn, function(e) self:FlashError(e) end, val)
		end
		if type(cfg.Callback) == "function" then
			local runCb = function()
				Diagnostics:SafeCallback(self.Title .. ":Callback", cfg.Callback, function(e) self:FlashError(e) end, val)
				if cfg.Notify then
					local n = type(cfg.Notify) == "table" and cfg.Notify or { Content = tostring(cfg.Notify) }
					NotificationManager:Notify(n)
				end
			end
			if cfg.Confirm and tab.Window then
				local c = type(cfg.Confirm) == "table" and cfg.Confirm or { Content = tostring(cfg.Confirm) }
				ModalManager:Show(tab.Window.RootFrame, {
					Title = c.Title or "Confirm",
					Content = c.Content or "Proceed with this action?",
					OnYes = runCb,
				})
			else
				runCb()
			end
		end
		if StateManager.AutoSave then
			StateManager:SaveConfiguration()
		end
	end

	function ctrl:IsDestroyed() return maid:IsDestroyed() end
	function ctrl:Destroy()
		if maid:IsDestroyed() then return false end
		StateManager:Unregister(self.Flag)
		return maid:Destroy()
	end

	local id = StateManager:GenerateStableId(tab.Title, ctrl.Type, title, cfg.Flag or cfg.Idx)
	ctrl.Flag = id
	StateManager:Register(id, ctrl)
	tab:RegisterElement(ctrl)

	if ctrl.Locked then ctrl:Lock(cfg.LockedTitle or "Locked") end
	return ctrl
end

