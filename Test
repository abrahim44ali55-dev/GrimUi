		Factory.Corner(nil, "CornerSmall"),
		Factory.Stroke(nil, "Border", 1, 0.4),
	})

	local function updateUI()
		local c = Color3.fromHSV(h, s, v)
		ctrl.Value = c
		ctrl.Color = c
		prev.BackgroundColor3 = c
		svMap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svDot.Position = UDim2.fromScale(s, 1 - v)
		svDot.BackgroundColor3 = c
		hueDot.Position = UDim2.fromScale(0.5, h)
		hexInput.Text = "#" .. c:ToHex():upper()
	end

	function ctrl:SetValue(col, alpha, silent)
		if typeof(col) == "Color3" then
			h, s, v = col:ToHSV()
		elseif type(col) == "string" then
			local ok, p = pcall(Color3.fromHex, col:gsub("#", ""))
			if ok and p then h, s, v = p:ToHSV() end
		end
		if type(alpha) == "number" then self.Transparency = math.clamp(alpha, 0, 1) end
		updateUI()
		self:_fireChanged(self.Value, silent)
		return self
	end
	ctrl.Set = ctrl.SetValue
	ctrl.SetValueRGB = ctrl.SetValue
	ctrl.GetValue = function(self) return self.Value, self.Transparency end

