-- 4 & 5. SLIDER & SLIDER WITH NUMERIC INPUT
ComponentRegistry:Register("slider", function(tab, cfg)
	cfg = type(cfg) == "table" and cfg or { Title = tostring(cfg) }
	cfg.Type = "Slider"
	local rng = type(cfg.Range) == "table" and cfg.Range or nil
	local vTbl = type(cfg.Value) == "table" and cfg.Value or nil

	local minV = tonumber(cfg.Min or (rng and rng[1]) or (vTbl and vTbl.Min)) or 0
	local maxV = tonumber(cfg.Max or (rng and rng[2]) or (vTbl and vTbl.Max)) or 100
	if minV > maxV then minV, maxV = maxV, minV end
	local step = tonumber(cfg.Increment or cfg.Step or cfg.Rounding) or 1
	if step <= 0 then step = 1 end
	local suffix = cfg.Suffix or cfg.ValueName or ""
	local hasBox = cfg.ShowInput == true or cfg.IsTextbox == true

	local defV = tonumber(cfg.Default or cfg.CurrentValue or (vTbl and vTbl.Default) or (type(cfg.Value) == "number" and cfg.Value)) or minV
	local ctrl = ComponentRegistry:CreateBaseCard(tab, cfg, false)

	local function snap(n)
		n = math.clamp(tonumber(n) or minV, minV, maxV)
		local s = math.floor(((n - minV) / step) + 0.5) * step + minV
		return tonumber(string.format("%.4f", math.clamp(s, minV, maxV))) or minV
	end

	ctrl.Value = snap(defV)
	ctrl.Min = minV
	ctrl.Max = maxV
	ctrl.Step = step

	local valDisplay
	if hasBox then
		valDisplay = Factory.Create("TextBox", {
			Size = UDim2.fromOffset(62, 22),
			Position = UDim2.new(1, 0, 0, 0),
			AnchorPoint = Vector2.new(1, 0),
			Text = tostring(ctrl.Value),
			Font = Enum.Font.Code,
			TextSize = 11,
			ClearTextOnFocus = false,
			ThemeTag = { BackgroundColor3 = "InputBg", TextColor3 = "TextPrimary" },
			Parent = ctrl.Content,
		}, {
			Factory.Corner(nil, "CornerSmall"),
			Factory.Stroke(nil, "Border", 1, 0.35),
		})
	else
		valDisplay = Factory.Create("TextLabel", {
			Size = UDim2.fromOffset(88, 18),
			Position = UDim2.new(1, 0, 0, 0),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Text = suffix ~= "" and (tostring(ctrl.Value) .. " " .. suffix) or tostring(ctrl.Value),
			Font = Enum.Font.Code,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Right,
			ThemeTag = { TextColor3 = "TextSecondary" },
			Parent = ctrl.Content,
		})
	end

	local railWrap = Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = ctrl.TextStack,
	})

	local rail = Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.fromScale(0, 0.5),
		AnchorPoint = Vector2.new(0, 0.5),
		ThemeTag = { BackgroundColor3 = "InputBg" },
		Parent = railWrap,
	}, { Factory.Corner(nil, 99) })

	local r0 = (maxV > minV) and ((ctrl.Value - minV) / (maxV - minV)) or 0
	local fill = Factory.Create("Frame", {
		Size = UDim2.fromScale(r0, 1),
		ThemeTag = { BackgroundColor3 = "Accent" },
		Parent = rail,
	}, { Factory.Corner(nil, 99) })

	local thumb = Factory.Create("Frame", {
		Size = UDim2.fromOffset(13, 13),
		Position = UDim2.fromScale(r0, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = rail,
	}, {
		Factory.Corner(nil, 99),
		Factory.Stroke(nil, "Accent", 2, 0),
	})

	local hit = Factory.Create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = railWrap,
	})

	function ctrl:SetValue(v, silent)
		local c = snap(v)
		local diff = (c ~= self.Value)
		self.Value = c
		self.CurrentValue = c
		local r = (self.Max > self.Min) and math.clamp((c - self.Min) / (self.Max - self.Min), 0, 1) or 0
		AnimationManager:Tween(fill, { Size = UDim2.fromScale(r, 1) }, 0.08)
		AnimationManager:Tween(thumb, { Position = UDim2.fromScale(r, 0.5) }, 0.08)
		valDisplay.Text = hasBox and tostring(c) or (suffix ~= "" and (tostring(c) .. " " .. suffix) or tostring(c))
		if diff or not silent then
			self:_fireChanged(c, silent)
		end
		return self
	end
	ctrl.Set = ctrl.SetValue
	ctrl.GetValue = function(self) return self.Value end

	local dragging = false
	local function updateFromX(x)
		local a = math.clamp((x - rail.AbsolutePosition.X) / math.max(rail.AbsoluteSize.X, 1), 0, 1)
		ctrl:SetValue(ctrl.Min + (ctrl.Max - ctrl.Min) * a, false)
	end

	ctrl.Maid:Connect(hit.InputBegan, function(inp)
		if not ctrl.Enabled or ctrl.Locked then return end
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			if tab.Container then tab.Container.ScrollingEnabled = false end
			updateFromX(inp.Position.X)
		end
	end)
	ctrl.Maid:Connect(UserInputService.InputChanged, function(inp)
		if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(inp.Position.X)
		end
	end)
	ctrl.Maid:Connect(UserInputService.InputEnded, function(inp)
		if dragging and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			if tab.Container then tab.Container.ScrollingEnabled = true end
		end
	end)

	if hasBox then
		ctrl.Maid:Connect(valDisplay.FocusLost, function()
			local n = tonumber(valDisplay.Text)
			if n then ctrl:SetValue(n, false) else valDisplay.Text = tostring(ctrl.Value) end
		end)
	end

	return ctrl
end)

