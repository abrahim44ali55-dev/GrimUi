ComponentRegistry:Register("keybind", function(tab, cfg)
	cfg = type(cfg) == "table" and cfg or { Title = tostring(cfg) }
	cfg.Type = "Keybind"
	cfg.RightReservedWidth = 86
	local ctrl = ComponentRegistry:CreateBaseCard(tab, cfg, false)

	local function normKey(k)
		if typeof(k) == "EnumItem" then return k.Name end
		if type(k) == "string" and k ~= "" then return k end
		return "F"
	end

	ctrl.Value = normKey(cfg.Default or cfg.CurrentKeybind or cfg.Value)
	ctrl.Mode = tostring(cfg.Mode or (cfg.Hold and "Hold") or "Toggle")
	ctrl.Toggled = false
	ctrl.Binding = false

	local btn = Factory.Create("TextButton", {
		Size = UDim2.new(0, 0, 0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromScale(1, 0.5),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = ctrl.Value,
		Font = Enum.Font.Code,
		TextSize = 11,
		ThemeTag = { BackgroundColor3 = "InputBg", TextColor3 = "TextPrimary" },
		Parent = ctrl.Content,
	}, {
		Factory.Corner(nil, "CornerSmall"),
		Factory.Stroke(nil, "Border", 1, 0.35),
		Factory.Padding(nil, 0, 0, 10, 10),
	})

	function ctrl:SetValue(k, mode, silent)
		self.Value = normKey(k)
		if mode then self.Mode = tostring(mode) end
		btn.Text = self.Value
		if cfg.CallOnChange and not silent then self:_fireChanged(self.Value, false) end
		return self
	end
	ctrl.Set = ctrl.SetValue
	ctrl.GetValue = function(self) return self.Value end
	ctrl.GetState = function(self) return self.Mode == "Always" or self.Toggled end

	ctrl.Maid:Connect(btn.MouseButton1Click, function()
		if not ctrl.Enabled or ctrl.Locked or ctrl.Binding then return end
		ctrl.Binding = true
		btn.Text = "..."
	end)

	ctrl.Maid:Connect(UserInputService.InputBegan, function(inp, gp)
		if ctrl.Binding then
			if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode ~= Enum.KeyCode.Unknown then
				ctrl.Binding = false
				ctrl:SetValue(inp.KeyCode == Enum.KeyCode.Escape and "None" or inp.KeyCode.Name, nil, false)
			end
			return
		end
		if gp or UserInputService:GetFocusedTextBox() or not ctrl.Enabled or ctrl.Locked then return end
		if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode.Name == ctrl.Value then
			if ctrl.Mode == "Hold" then
				ctrl.Toggled = true
				ctrl:_fireChanged(true, false)
			else
				ctrl.Toggled = not ctrl.Toggled
				ctrl:_fireChanged(ctrl.Toggled, false)
			end
		end
	end)

	ctrl.Maid:Connect(UserInputService.InputEnded, function(inp)
		if ctrl.Mode == "Hold" and ctrl.Toggled and inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode.Name == ctrl.Value then
			ctrl.Toggled = false
			ctrl:_fireChanged(false, false)
		end
	end)

	return ctrl
end)

