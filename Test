function Factory.Stroke(parent, colorTokenOrColor, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.4
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	if type(colorTokenOrColor) == "string" then
		ThemeEngine:Bind(s, { Color = colorTokenOrColor })
	elseif typeof(colorTokenOrColor) == "Color3" then
		s.Color = colorTokenOrColor
	end
	if parent then s.Parent = parent end
	return s
end

function Factory.Padding(parent, t, b, l, r)
