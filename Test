		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = self.Order,
		Parent = self.Holder,
	})
	maid:Add(wrap)

	local card = Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(1, 350, 0, 0),
		ThemeTag = { BackgroundColor3 = "ModalBg" },
		Parent = wrap,
	}, {
		Factory.Corner(nil, "CornerElement"),
		Factory.Stroke(nil, accentToken, 1, 0.3),
	})

	local content = Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		Factory.Padding(nil, 11, 13, 13, 13),
		Factory.Create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local topRow = Factory.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = content,
	})

	local ico = Factory.Create("ImageLabel", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromScale(0, 0.5),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = topRow,
	})
	IconManager:Apply(ico, cfg.Icon or cfg.Image or defIcon, accentToken)

	Factory.Create("TextLabel", {
		Size = UDim2.new(1, -44, 1, 0),
		Position = UDim2.fromOffset(22, 0),
		BackgroundTransparency = 1,
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ThemeTag = { TextColor3 = "TextPrimary" },
		Parent = topRow,
	})

	local closeBtn = Factory.Create("TextButton", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.fromScale(1, 0.5),
		AnchorPoint = Vector2.new(1, 0.5),
