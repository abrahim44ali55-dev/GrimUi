		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	ctrl.Maid:Connect(floatBtn.MouseButton1Click, function()
		if moved then return end
		Diagnostics:SafeCallback("FloatingButton", cfg.Callback)
	end)

	ctrl:OnChanged(function(state)
		floatBtn.Visible = state == true
	end)
	return ctrl
end)

