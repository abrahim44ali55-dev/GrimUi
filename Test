function NotificationManager:Notify(cfg)
	cfg = type(cfg) == "table" and cfg or { Content = tostring(cfg) }
	while #self.Active >= self.MaxStack do
		local oldest = table.remove(self.Active, 1)
		if oldest and oldest.Close then oldest:Close() end
	end

	local title = tostring(cfg.Title or cfg.Name or "Notification")
	local body = tostring(cfg.Content or cfg.Text or cfg.Message or "")
	local kind = tostring(cfg.Type or "Info"):lower()
	local dur = tonumber(cfg.Duration or cfg.Time) or 4
	local actions = type(cfg.Actions or cfg.Buttons) == "table" and (cfg.Actions or cfg.Buttons) or {}

	local accentToken, defIcon = "Info", "info"
	if kind == "success" then accentToken = "Success"; defIcon = "check-circle"
	elseif kind == "warning" or kind == "warn" then accentToken = "Warning"; defIcon = "alert-triangle"
	elseif kind == "error" or kind == "danger" then accentToken = "Error"; defIcon = "x-circle"
	end

	self.Order += 1
	local maid = Lifecycle.new()
