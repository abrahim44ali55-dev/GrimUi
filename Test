function IconManager:AddIcons(map)
	if type(map) ~= "table" then return end
	for k, v in pairs(map) do
		self.Assets[tostring(k):lower()] = v
	end
	self.Cache = {}
end

function IconManager:Resolve(icon)
	if icon == nil or icon == "" or icon == false or icon == 0 then return nil end
	local key = tostring(icon)
	if self.Cache[key] then return self.Cache[key] end

	local res = nil
	if type(icon) == "number" then
		res = { Image = "rbxassetid://" .. tostring(math.floor(icon)) }
	elseif type(icon) == "string" then
		if icon:match("^rbxassetid://") or icon:match("^rbxasset://") or icon:match("^rbxthumb://") then
			res = { Image = icon }
		elseif icon:match("^%d+$") then
			res = { Image = "rbxassetid://" .. icon }
		else
			local norm = icon:lower():gsub("^lucide[:%-]", ""):gsub("[_%s]+", "-")
			if self.Assets[norm] then
				res = { Image = self.Assets[norm] }
			end
		end
	end

	if not res then
		res = { Image = self.Fallback, IsFallback = true }
	end
	self.Cache[key] = res
	return res
end

function IconManager:Apply(imgLabel, icon, colorToken)
	local res = self:Resolve(icon)
	if not res then
		imgLabel.Visible = false
		return false
	end
	imgLabel.Visible = true
	imgLabel.Image = res.Image
	if colorToken then
		ThemeEngine:Bind(imgLabel, { ImageColor3 = colorToken })
	end
	return true
end

