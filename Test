function WindowManager:CreateWindow(cfg)
	cfg = type(cfg) == "table" and cfg or { Title = tostring(cfg) }
	local maid = Lifecycle.new()

	local title = tostring(cfg.Title or cfg.Name or "UltraFusion UI")
	local subTitle = tostring(cfg.SubTitle or cfg.LoadingSubtitle or cfg.Author or "v2.0")
	ThemeEngine:SetTheme(cfg.Theme or "ObsidianDark", false)

	if cfg.SaveConfig or (type(cfg.ConfigurationSaving) == "table" and cfg.ConfigurationSaving.Enabled) then
		StateManager.AutoSave = true
	end

	local screenGui = Factory.Create("ScreenGui", {
		Name = "UltraFusion_" .. title:gsub("%W+", ""),
