local Factory = {}

function Factory.GetSafeParent(customParent)
	if typeof(customParent) == "Instance" then return customParent end
	local okH, hui = pcall(function() return gethui and gethui() end)
	if okH and hui then return hui end
	local lp = Players.LocalPlayer
	if lp then
		local okP, pgui = pcall(function()
			return lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 2)
		end)
		if okP and pgui then return pgui end
	end
	return game:GetService("CoreGui")
end

function Factory.Create(className, props, children)
	local inst = Instance.new(className)
	if className == "Frame" or className == "ScrollingFrame" or className == "CanvasGroup" then
		inst.BorderSizePixel = 0
	elseif className == "TextLabel" or className == "TextButton" or className == "TextBox" then
		inst.BorderSizePixel = 0
		inst.Font = Enum.Font.GothamMedium
		inst.TextSize = 13
		if className == "TextButton" then inst.AutoButtonColor = false end
	elseif className == "ImageLabel" or className == "ImageButton" then
		inst.BorderSizePixel = 0
		inst.BackgroundTransparency = 1
	end

	local themeTag = nil
	if props then
		for k, v in pairs(props) do
			if k == "ThemeTag" then
				themeTag = v
			elseif k ~= "Parent" then
				inst[k] = v
			end
		end
	end

	if children then
		for _, ch in ipairs(children) do
			if typeof(ch) == "Instance" then
				ch.Parent = inst
			end
		end
	end

	if themeTag then
		ThemeEngine:Bind(inst, themeTag)
	end

	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function Factory.Corner(parent, radiusTokenOrPx)
	local c = Instance.new("UICorner")
	local px = type(radiusTokenOrPx) == "string" and ThemeEngine:GetToken(radiusTokenOrPx) or radiusTokenOrPx or 8
	c.CornerRadius = UDim.new(0, px)
	if parent then c.Parent = parent end
