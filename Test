			PlaceholderText = "Search options...",
			Font = Enum.Font.Gotham,
			TextSize = 11,
			ClearTextOnFocus = false,
			ThemeTag = { BackgroundColor3 = "InputBg", TextColor3 = "TextPrimary", PlaceholderColor3 = "TextMuted" },
			Parent = drawer,
		}, {
			Factory.Corner(nil, "CornerSmall"),
			Factory.Padding(nil, 0, 0, 8, 8),
		})
	end

	local list = Factory.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, isSearch and -36 or -6),
		Position = UDim2.fromOffset(0, isSearch and 36 or 6),
		BackgroundTransparency = 1,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ThemeTag = { ScrollBarImageColor3 = "Accent" },
		Parent = drawer,
	}, {
		Factory.Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local optBtns = {}
	local function rebuild()
		for _, b in ipairs(optBtns) do pcall(function() b:Destroy() end) end
		table.clear(optBtns)
		local q = sBox and sBox.Text:lower() or ""
		for i, opt in ipairs(ctrl.Options) do
			local str = tostring(opt)
			if q == "" or str:lower():find(q, 1, true) then
				local active = isMulti and (table.find(ctrl.Value, opt) ~= nil) or (ctrl.Value == opt)
				local b = Factory.Create("TextButton", {
					Size = UDim2.new(1, -4, 0, 26),
					Text = str,
					Font = active and Enum.Font.GothamBold or Enum.Font.Gotham,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = i,
					ThemeTag = {
						BackgroundColor3 = active and "Accent" or "InputBg",
						TextColor3 = active and "AccentText" or "TextPrimary",
					},
					Parent = list,
				}, {
					Factory.Corner(nil, "CornerSmall"),
					Factory.Padding(nil, 0, 0, 8, 8),
				})
				table.insert(optBtns, b)
				ctrl.Maid:Connect(b.MouseButton1Click, function()
					if isMulti then
						local idx = table.find(ctrl.Value, opt)
						if idx then table.remove(ctrl.Value, idx) else table.insert(ctrl.Value, opt) end
						selLbl.Text = summary()
						rebuild()
						ctrl:_fireChanged(ctrl.Value, false)
					else
						ctrl:SetValue(opt, false)
						ctrl:Toggle(false)
					end
				end)
			end
		end
	end

	function ctrl:Toggle(open)
		if open == nil then open = not self.Opened end
		self.Opened = open == true
		if self.Opened then
			rebuild()
			drawer.Visible = true
			local h = math.min(#self.Options * 30, 140) + (isSearch and 40 or 10)
			AnimationManager:Tween(chev, { Rotation = 180 }, 0.16)
			AnimationManager:Tween(drawer, { Size = UDim2.new(1, 0, 0, h) }, 0.18)
		else
			AnimationManager:Tween(chev, { Rotation = 0 }, 0.16)
			AnimationManager:Tween(drawer, { Size = UDim2.new(1, 0, 0, 0) }, 0.16, nil, nil, function()
				if not self.Opened then drawer.Visible = false end
			end)
		end
	end

	function ctrl:SetValue(v, silent)
		if isMulti then
			self.Value = type(v) == "table" and table.clone(v) or { tostring(v) }
		else
			self.Value = type(v) == "table" and v[1] or v
		end
		self.CurrentOption = self.Value
		selLbl.Text = summary()
		if self.Opened then rebuild() end
		self:_fireChanged(self.Value, silent)
		return self
	end
	ctrl.Set = ctrl.SetValue
	ctrl.GetValue = function(self) return self.Value end
	ctrl.Refresh = function(self, newOpts)
		if type(newOpts) == "table" then self.Options = table.clone(newOpts) end
		if self.Opened then rebuild() end
		return self
	end

	ctrl.Maid:Connect(trig.MouseButton1Click, function()
		if not ctrl.Enabled or ctrl.Locked or tab.IsScrolling then return end
		ctrl:Toggle()
	end)
	if sBox then ctrl.Maid:Connect(sBox:GetPropertyChangedSignal("Text"), rebuild) end
	return ctrl
end)

