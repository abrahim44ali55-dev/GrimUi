	ctrl.Maid:Connect(svMap.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			mode = "SV"
			if tab.Container then tab.Container.ScrollingEnabled = false end
		end
	end)
	ctrl.Maid:Connect(hueBar.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			mode = "HUE"
			if tab.Container then tab.Container.ScrollingEnabled = false end
		end
	end)
	ctrl.Maid:Connect(UserInputService.InputChanged, function(inp)
		if not mode then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
			if mode == "SV" then
				s = math.clamp((inp.Position.X - svMap.AbsolutePosition.X) / math.max(svMap.AbsoluteSize.X, 1), 0, 1)
				v = 1 - math.clamp((inp.Position.Y - svMap.AbsolutePosition.Y) / math.max(svMap.AbsoluteSize.Y, 1), 0, 1)
			elseif mode == "HUE" then
				h = math.clamp((inp.Position.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
			end
			updateUI()
			ctrl:_fireChanged(ctrl.Value, false)
		end
	end)
	ctrl.Maid:Connect(UserInputService.InputEnded, function(inp)
		if mode and (inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch) then
			mode = nil
			if tab.Container then tab.Container.ScrollingEnabled = true end
		end
	end)

	ctrl.Maid:Connect(hexInput.FocusLost, function() ctrl:SetValue(hexInput.Text, ctrl.Transparency, false) end)
	ctrl.Maid:Connect(prev.MouseButton1Click, function()
		if not ctrl.Enabled or ctrl.Locked then return end
		ctrl.Opened = not ctrl.Opened
		if ctrl.Opened then
			drawer.Visible = true
			AnimationManager:Tween(drawer, { Size = UDim2.new(1, 0, 0, 114) }, 0.18)
		else
			AnimationManager:Tween(drawer, { Size = UDim2.new(1, 0, 0, 0) }, 0.16, nil, nil, function()
				if not ctrl.Opened then drawer.Visible = false end
			end)
		end
	end)

	return ctrl
end)

