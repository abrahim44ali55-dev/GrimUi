		Text = "×",
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		ThemeTag = { TextColor3 = "TextMuted" },
		Parent = topRow,
	})

	if body ~= "" then
		Factory.Create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = body,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ThemeTag = { TextColor3 = "TextSecondary" },
			LayoutOrder = 2,
			Parent = content,
		})
	end

	if #actions > 0 then
		local actRow = Factory.Create("Frame", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			LayoutOrder = 3,
			Parent = content,
		}, {
			Factory.Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
			}),
		})
		for _, a in ipairs(actions) do
			local b = Factory.Create("TextButton", {
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = tostring(a.Title or a.Name or "Action"),
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				ThemeTag = { BackgroundColor3 = "ElementBgHover", TextColor3 = "TextPrimary" },
				Parent = actRow,
			}, {
				Factory.Corner(nil, "CornerSmall"),
				Factory.Padding(nil, 0, 0, 10, 10),
			})
			maid:Connect(b.MouseButton1Click, function()
				Diagnostics:SafeCallback("ToastAction", a.Callback)
				toast:Close()
			end)
